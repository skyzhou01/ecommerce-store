# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# Grab the pooled connection string from the Neon console:
# https://console.neon.tech -> your project -> Connection Details
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Better Auth
# Generate a secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the browser auth client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
